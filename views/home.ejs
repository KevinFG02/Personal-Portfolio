<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Form</title>

    <link rel="stylesheet" href="styles/form-styles.css">
    <link rel="icon" href="images/KFG-favicon.png">
    <script src="scripts/form.js" defer></script>
</head>
<body>
    <main>
        <form id="contact-form" action="/submit-meeting" method="post">
            <h1>Contact Form</h1>
            <fieldset id="input-info">
                <div>
                    <label for="fname">First Name</label>
                    <span class="error" id="error-fname">First Name Is Missing</span> <br>
                    <input type="text" id="fname" name="fname">
                </div>
                <div>
                    <label for="lname">Last Name</label>
                    <span class="error" id="error-lname">Last Name Is Missing</span> <br>
                    <input type="text" id="lname" name="lname">
                </div>
                <div>
                    <label for="job">Job Title</label> <br>
                    <input type="text" id="job" name="job">
                </div>
                <div>
                    <label for="company">Company</label><br>
                    <input type="text" id="company" name="company">
                </div>
                <div>
                    <label for="linkedin">Linkedin URL</label>
                    <span class="error" id="error-linkedin">Linkedin URL Invalid</span> <br>
                    <input type="text" id="linkedin" name="linkedin">
                </div>
                <div>
                    <label for="useremail">Email Address</label>
                    <span class="error" id="error-email">Email Invalid</span> <br>
                    <input type="text" id="useremail" name="useremail">
                </div>
            </fieldset>

            <fieldset id="meeting">
                <div>
                    <label for="meetingoption">How Do We Meet?</label>
                    <span class="error" id="error-meeting">Option Not Chosen</span> <br>
                    <select id="meetingoption" name="meetingoption">
                        <option value="none">Please Select</option>
                        <option value="online">Online</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div>
                    <div id="otherbox">
                        <label for="meetother">Other (Please Specify)</label>
                        <input type="text" id="meetother" name="meetother">
                    </div>        
                </div>
            </fieldset>

            <label for="message">Message</label> <br>
            <textarea rows="5" id="message" name="message"></textarea>

            <input type="checkbox" id="mailList" name="mailList" value="mail">
            <label for="mailList">Add Me To Your Mailing List</label> 
            <span class="error" id="error-format">Email Missing Or Invalid</span> <br>

            <fieldset id="emailformatfieldset">
                <span id="emailFormat">Choose An Email Format:</span>
                <label for="htmlOption">
                <input type="radio" id="htmlOption" name="methodformat" value="htmlOption">
                    HTML
                </label>
                <label for="textOption">
                <input type="radio" id="textOption" name="methodformat" value="textOption">
                    Text
                </label>
            </fieldset> <br>
        
            <button type="submit" id="submit-button">Submit</button>
        </form>
    </main>
</body>
</html>